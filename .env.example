# Copy to .env and replace this with your Garmin API key before running sync.
GARMIN_API_KEY=replace-with-your-garmin-api-key

# Synthetic local-only credentials from compose.yaml; never use in production.
DATABASE_URL=postgres://garmin_daily:dev-only-password@localhost:15432/garmin_daily?sslmode=disable
TEST_DATABASE_URL=postgres://garmin_daily:dev-only-password@localhost:15432/garmin_daily?sslmode=disable
